{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": " 󰄾 "
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "34"
    },
    {
      "type": "kernel",
      "key": "󰌽 Kernel",
      "keyColor": "35"
    },
    {
      "type": "uptime",
      "key": "󱑂 Uptime",
      "keyColor": "32"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "33"
    },
    {
      "type": "wm",
      "key": "󱂬 Desktop",
      "keyColor": "36"
    },
    {
      "type": "display",
      "key": "󰍹 Display",
      "keyColor": "34",
      "compactType": "original"
    },
    {
      "type": "terminal",
      "key": "󰞷 Terminal",
      "keyColor": "31"
    },
    {
      "type": "shell",
      "key": "󰞷 Shell",
      "keyColor": "35"
    },
    {
      "type": "font",
      "key": "󰉼 Font",
      "keyColor": "36"
    },
    {
      "type": "cpu",
      "key": "󰻠 CPU",
      "keyColor": "34"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "keyColor": "35"
    },
    {
      "type": "memory",
      "key": "󰾆 Memory",
      "keyColor": "32"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk (/)",
      "keyColor": "33",
      "folders": "/"
    },
    {
      "type": "localip",
      "key": "󰩟 Local IP",
      "keyColor": "36",
      "showIpv6": false
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
