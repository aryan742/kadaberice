# ─────────────────────────────────────────────────────────────────
# AryanOS — Saffron-Theme Dunst Notification Configuration
# ─────────────────────────────────────────────────────────────────

[global]
    # Font styling
    font = JetBrains Mono Nerd Font 10

    # Display settings
    monitor = 0
    follow = mouse
    width = 300
    height = 110
    origin = top-right
    offset = 12x12
    scale = 0
    notification_limit = 5

    # Design rules matching Hyprland
    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    # Borders, outlines and shapes
    frame_width = 2
    frame_color = "#D97706"
    separator_color = frame
    corner_radius = 6

    # Behavior
    transparency = 8
    gap_size = 6
    line_height = 4
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    # Audio cues
    enable_audio = no

[urgency_low]
    background = "#111111"
    foreground = "#F5F0E6"
    frame_color = "#1A1A1A"
    timeout = 4

[urgency_normal]
    background = "#111111"
    foreground = "#F5F0E6"
    frame_color = "#D97706"
    timeout = 7

[urgency_critical]
    background = "#7F1D1D"
    foreground = "#F5F0E6"
    frame_color = "#D4AF37"
    timeout = 0
