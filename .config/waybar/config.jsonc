{
  "layer": "top",
  "position": "bottom",
  "height": 42,
  "width": 1280,
  "margin-bottom": 12,
  "spacing": 8,

  // Modules Layout
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [],
  "modules-right": [
    "memory",
    "pulseaudio",
    "bluetooth",
    "network",
    "battery",
    "clock",
    "custom/notification",
    "custom/power"
  ],

  // Left Modules
  "custom/launcher": {
    "format": "▲",
    "on-click": "rofi -show drun",
    "tooltip": false
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "all-outputs": true,
    "show-special": false,
    "format-icons": {
      "default": "•",
      "active": "◉",
      "urgent": ""
    }
  },

  "hyprland/window": {
    "format": "󰘚 {title}",
    "max-length": 35,
    "separate-outputs": true,
    "rewrite": {
      "": "󰘚 Desktop"
    }
  },

  // Right Modules
  "memory": {
    "interval": 5,
    "format": "󰾆 {percentage}%",
    "tooltip": true,
    "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol"
  },

  "bluetooth": {
    "format": "󰂯 {status}",
    "format-connected": "󰂱 {device_alias}",
    "format-disabled": "󰂲 Off",
    "on-click": "blueman-manager",
    "tooltip-format": "{controller_alias}\t{controller_address}"
  },

  "network": {
    "format-wifi": " {essid}",
    "format-ethernet": "󰈀 Wired",
    "format-disconnected": "󰤮 None",
    "on-click": "nm-connection-editor",
    "tooltip-format": "IP: {ipaddr}/{cidr}"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },

  "clock": {
    "timezone": "Asia/Kolkata",
    "format": " {:%I:%M %p}",
    "format-alt": " {:%a, %d %b %Y  %I:%M %p}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "interval": 60,
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffb0ca'><b>{}</b></span>",
        "days": "<span color='#e8d5e8'><b>{}</b></span>",
        "weeks": "<span color='#7171ac'><b>W{}</b></span>",
        "weekdays": "<span color='#c4a8c4'><b>{}</b></span>",
        "today": "<span color='#ff6ba0'><b><u>{}</u></b></span>"
      }
    }
  },

  "custom/notification": {
    "tooltip": true,
    "format": "{text}",
    "return-type": "json",
    "exec": "~/.config/hypr/scripts/notifications.py --status",
    "on-click": "~/.config/hypr/scripts/notifications.py",
    "on-click-right": "~/.config/hypr/scripts/notifications.py --toggle-dnd",
    "on-click-middle": "~/.config/hypr/scripts/notifications.py --clear",
    "interval": 2
  },

  "custom/power": {
    "format": "⏻",
    "on-click": "wlogout",
    "tooltip": false
  }
}
