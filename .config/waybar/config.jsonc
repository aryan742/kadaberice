{
  "layer": "top",
  "position": "bottom",
  "height": 42,
  "width": 1560,
  "margin-bottom": 10,
  "spacing": 6,

  // Modules Layout
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock",
    "mpris"
  ],
  "modules-right": [
    "tray",
    "cpu",
    "memory",
    "backlight",
    "pulseaudio",
    "bluetooth",
    "network",
    "battery",
    "custom/power"
  ],

  // ── Left Modules ──
  "custom/launcher": {
    "format": "",
    "on-click": "rofi -show drun",
    "on-click-right": "~/.config/hypr/scripts/toggle-ags.sh app-launcher",
    "tooltip-format": "󰀻 Applications\n• Left-Click: Rofi Menu\n• Right-Click: CoverFlow Launcher"
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "all-outputs": true,
    "sort-by-number": true,
    "active-only": false,
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5]
    }
  },

  "hyprland/window": {
    "format": "󰘚 {title}",
    "max-length": 30,
    "separate-outputs": true,
    "rewrite": {
      "": "󰘚 Desktop",
      "(.*) — Vivaldi": "󰖟 $1",
      "(.*) - Kitty": "󰄛 $1",
      "(.*) - Thunar": "󰉋 $1"
    }
  },

  // ── Center Modules ──
  "clock": {
    "timezone": "Asia/Kolkata",
    "format": "󰥔 {:%I:%M %p}",
    "format-alt": "󰸗 {:%A, %d %B %Y  •  %I:%M:%S %p}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "interval": 1,
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<b>{}</b>",
        "days": "<b>{}</b>",
        "weeks": "<b>W{}</b>",
        "weekdays": "<b>{}</b>",
        "today": "<b><u>{}</u></b>"
      }
    }
  },

  "mpris": {
    "format": "{player_icon} {title} - {artist}",
    "format-paused": "{status_icon} <i>{title}</i>",
    "player-icons": {
      "default": "󰝚",
      "spotify": "󰓇",
      "vivaldi": "󰖟"
    },
    "status-icons": {
      "paused": "󰏤"
    },
    "max-length": 28,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },

  // ── Right Modules ──
  "tray": {
    "icon-size": 15,
    "spacing": 8
  },

  "cpu": {
    "interval": 3,
    "format": "󰍛 {usage}%",
    "tooltip": true,
    "on-click": "kitty -e btop"
  },

  "memory": {
    "interval": 4,
    "format": "󰾆 {percentage}%",
    "tooltip": true,
    "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)\nSwap: {swapUsed:0.1f}GiB / {swapTotal:0.1f}GiB",
    "on-click": "kitty -e btop"
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-",
    "tooltip": false
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "󰏲",
      "portable": "󰏲",
      "car": "󰄋",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱 {device_alias}",
    "format-disabled": "󰂲",
    "on-click": "blueman-manager",
    "tooltip-format": "󰂯 Bluetooth: {status}\n{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "󰂱 Connected: {device_alias}\nBattery: {device_battery_percentage}%"
  },

  "network": {
    "format-wifi": "󰤨 {essid}",
    "format-ethernet": "󰈀 Wired",
    "format-linked": "󰈀 (No IP)",
    "format-disconnected": "󰤮 Offline",
    "tooltip-format": "󰩟 IP: {ipaddr}\n󰞒 Gateway: {gwaddr}\n󰖩 Signal: {signalStrength}% ({signaldBm} dBm)\n󰛳 Frequency: {frequency} MHz",
    "on-click": "nm-connection-editor"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-alt": "{icon} {time}",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },

  "custom/power": {
    "format": "⏻",
    "on-click": "wlogout",
    "tooltip-format": "Power Menu"
  }
}
