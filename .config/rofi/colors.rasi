/* Matugen Generated Rofi Palette */
* {
    matugen-primary: #f3bd6e;
    matugen-on-primary: #442b00;
    matugen-primary-container: #624000;
    matugen-on-primary-container: #ffddb1;

    matugen-secondary: #ddc2a1;
    matugen-on-secondary: #3e2e16;

    matugen-surface: #18120b;
    matugen-on-surface: #ede0d4;
    matugen-background: #18120b;
    matugen-on-background: #ede0d4;
    matugen-outline: #9b8f80;
}
